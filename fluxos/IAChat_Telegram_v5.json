        "jsCode": "const item = $input.item;\nconst b = item.binary && item.binary.data;\nif (b) {\n  const mime = (b.mimeType || '').toLowerCase();\n  const map = { 'audio/ogg': 'ogg', 'audio/opus': 'opus', 'audio/mpeg': 'mp3', 'audio/mp4': 'm4a', 'audio/x-m4a': 'm4a', 'audio/wav': 'wav', 'audio/x-wav': 'wav', 'audio/webm': 'webm', 'audio/flac': 'flac' };\n  const ok = ['flac','mp3','mp4','mpeg','mpga','m4a','ogg','opus','wav','webm'];\n  let ext = map[mime];\n  if (!ext) {\n    const m = (b.fileName || '').toLowerCase().match(/\\.([a-z0-9]+)$/);\n    ext = (m && ok.includes(m[1])) ? m[1] : 'ogg';\n  }\n  b.fileName = 'audio.' + ext;\n  if (!b.mimeType) b.mimeType = 'audio/ogg';\n}\nreturn item;"
