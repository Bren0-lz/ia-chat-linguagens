# Banco de dados (mesma instância do bot Telegram)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Token do bot IAChat no Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Segredo para assinar os JWTs (use uma string longa e aleatória)
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria

# Nome do bot Telegram (para o widget de login na landing page)
VITE_TELEGRAM_BOT_NAME=SeuBotAqui_Bot

# Link direto para o bot (botão "Começar no Telegram")
VITE_TELEGRAM_BOT_LINK=https://t.me/SeuBotAqui_Bot

# Telegram ID do usuário admin (veja em t.me/userinfobot)
VITE_ADMIN_TELEGRAM_ID=123456789
ADMIN_TELEGRAM_ID=123456789

# Webhook do n8n para testar o agente direto pelo painel admin
N8N_WEBHOOK_URL=https://seu-n8n.com/webhook/telegram-iachat-webhook
