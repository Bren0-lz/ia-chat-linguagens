        "jsCode": "const d = $input.item.json;\nconst mode = d.callbackData === 'mode_teacher' ? 'teacher' : 'chat';\nconst sql = \"UPDATE students SET mode = '\" + mode + \"', onboarding = 'done', updated_at = now() WHERE user_id = \" + parseInt(d.userId, 10) + \";\";\nconst confirm = mode === 'teacher'\n  ? \"📚 Modo Professor! Vou te passar exercícios e corrigir cada um. Let's start — what do you want to practice? 😊\"\n  : \"💬 Modo Conversa! Bora bater um papo. So, what did you do today? 😊\";\nreturn { json: { ...d, mode, sql, confirm } };"
