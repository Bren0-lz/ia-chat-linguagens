    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $input.item.json;\n// FIX: impede completar onboarding sem nome/idade (ex.: callback de modo numa\n// sessão diferente com teclado inline cacheado pelo Telegram).\nif (!d.name || !d.age) {\n  const sql = \"UPDATE students SET updated_at = now() WHERE user_id = \" + parseInt(d.userId, 10) + \";\";\n  const confirm = \"Vamos primeiro terminar seu cadastro! Digite /start para começar 😊\";\n  return { json: { ...d, mode: d.mode || 'chat', sql, confirm } };\n}\nconst mode = d.callbackData === 'mode_teacher' ? 'teacher' : 'chat';\nconst sql = \"UPDATE students SET mode = '\" + mode + \"', onboarding = 'done', updated_at = now() WHERE user_id = \" + parseInt(d.userId, 10) + \";\";\nconst confirm = mode === 'teacher'\n  ? \"📚 Modo Professor! Vou te passar exercícios e corrigir cada um. Let's start — what do you want to practice? 😊\"\n  : \"💬 Modo Conversa! Bora bater um papo. So, what did you do today? 😊\";\nreturn { json: { ...d, mode, sql, confirm } };"
