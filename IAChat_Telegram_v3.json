      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const n = $('Normalize').item.json;\nconst s = $input.item.json;\nlet route;\nif (n.command === '/start') {\n  route = (s.onboarding === 'done') ? 'menu' : 'onboarding';\n} else if (n.type === 'callback' && String(n.callbackData).startsWith('mode_')) {\n  route = 'mode_switch';\n} else if (n.type === 'non_text') {\n  route = 'non_text';\n} else if (s.onboarding !== 'done') {\n  route = 'onboarding';\n} else if (n.command === '/menu' || n.command === '/modo') {\n  route = 'menu';\n} else {\n  route = 'agent';\n}\nreturn { json: { ...s, ...n, route } };"
