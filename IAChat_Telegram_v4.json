        "query": "=INSERT INTO students (user_id)\nVALUES ({{ $('Normalizar').item.json.userId }})\nON CONFLICT (user_id) DO UPDATE SET updated_at = now()\nRETURNING user_id, name, age, mode, onboarding, profile, msg_count;",
