    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $input.item.json;\nfunction q(v){ return (v === null || v === undefined) ? 'NULL' : \"'\" + String(v).replace(/'/g, \"''\") + \"'\"; }\nlet next, reply, showMenu = false, saveName = null, saveAge = null, menuIntro = null;\nif (d.onboarding === 'new') {\n  next = 'awaiting_name';\n  reply = \"Oi! Eu sou o IAChat 😊 Qual é o seu nome?\";\n} else if (d.onboarding === 'awaiting_name') {\n  saveName = (d.text || '').slice(0, 50);\n  next = 'awaiting_age';\n  reply = \"Prazer, \" + saveName + \"! Quantos anos você tem?\";\n} else if (d.onboarding === 'awaiting_age') {\n  const m = (String(d.text || '').match(/\\d{1,2}/) || [])[0];\n  if (!m) {\n    next = 'awaiting_age';\n    reply = \"Só o número, por favor 😊 Quantos anos você tem?\";\n  } else {\n    saveAge = parseInt(m, 10);\n    next = 'menu';\n    showMenu = true;\n    reply = '';\n    menuIntro = \"Cadastro feito! 🎉 Como você quer começar? 👇\";\n  }\n} else {\n  // ja em 'menu' e o aluno mandou texto em vez de tocar num botao: lembra com gentileza, sem repetir o menu cru\n  next = 'menu';\n  showMenu = true;\n  reply = '';\n  menuIntro = \"É só tocar em um dos botões abaixo pra começar 👇\";\n}\nconst sets = [\"onboarding = \" + q(next), \"updated_at = now()\"];\nif (saveName !== null) sets.push(\"name = \" + q(saveName));\nif (saveAge !== null) sets.push(\"age = \" + parseInt(saveAge, 10));\nconst sql = \"UPDATE students SET \" + sets.join(', ') + \" WHERE user_id = \" + parseInt(d.userId, 10) + \";\";\nreturn { json: { ...d, next, reply, showMenu, saveName, saveAge, menuIntro, sql } };"
