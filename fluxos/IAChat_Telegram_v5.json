        "jsCode": "const userId = parseInt($('Montar Prompt de Perfil').first().json.userId, 10);\nlet raw = String($json.output || '').replace(/```json/gi, '').replace(/```/g, '').trim();\nconst a = raw.indexOf('{'); const b = raw.lastIndexOf('}');\nlet obj = null;\nif (a !== -1 && b !== -1) { try { obj = JSON.parse(raw.slice(a, b + 1)); } catch (e) {} }\nlet sql;\nif (obj) {\n  // sucesso: salva o perfil e zera o contador\n  const profileJson = JSON.stringify(obj).replace(/'/g, \"''\");\n  sql = \"UPDATE students SET profile = '\" + profileJson + \"'::jsonb, msg_count = 0 WHERE user_id = \" + userId + \";\";\n} else {\n  // falha na extracao: NAO mexe no profile e recua o contador para tentar de novo em ~5 mensagens (em vez de zerar e perder a janela). 15 = limiar do no 'Precisa Atualizar?' (20) menos 5.\n  sql = \"UPDATE students SET msg_count = 15 WHERE user_id = \" + userId + \";\";\n}\nreturn { json: { sql, ok: obj !== null } };"
