    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $input.item.json;\nfunction q(v){ return (v === null || v === undefined) ? 'NULL' : \"'\" + String(v).replace(/'/g, \"''\") + \"'\"; }\nlet next, reply, showMenu = false, saveName = null, saveAge = null;\nif (d.onboarding === 'new') {\n  next = 'awaiting_name';\n  reply = \"Hi! I'm IAChat 😊 What's your name?\";\n} else if (d.onboarding === 'awaiting_name') {\n  saveName = (d.text || '').slice(0, 50);\n  next = 'awaiting_age';\n  reply = \"Nice to meet you, \" + saveName + \"! How old are you?\";\n} else if (d.onboarding === 'awaiting_age') {\n  const m = (String(d.text || '').match(/\\d{1,2}/) || [])[0];\n  if (!m) {\n    next = 'awaiting_age';\n    reply = \"Just the number, please 😊 How old are you?\";\n  } else {\n    saveAge = parseInt(m, 10);\n    next = 'menu';\n    showMenu = true;\n    reply = '';\n  }\n} else {\n  next = 'menu';\n  showMenu = true;\n  reply = '';\n}\nconst sets = [\"onboarding = \" + q(next), \"updated_at = now()\"];\nif (saveName !== null) sets.push(\"name = \" + q(saveName));\nif (saveAge !== null) sets.push(\"age = \" + parseInt(saveAge, 10));\nconst sql = \"UPDATE students SET \" + sets.join(', ') + \" WHERE user_id = \" + parseInt(d.userId, 10) + \";\";\nreturn { json: { ...d, next, reply, showMenu, saveName, saveAge, sql } };"
      },
