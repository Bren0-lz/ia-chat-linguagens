# Copie este arquivo pra .env e preencha com sua connection string real.
# .env está no .gitignore — nunca commite a senha.
#
# Pegue a URL em: Supabase → Project Settings → Database → Connection pooling (Session)
# IMPORTANTE: use o Session pooler (porta 5432), não o Transaction (6543).

DATABASE_URL=postgresql://postgres.SEU_REF:SUA_SENHA@aws-1-us-east-1.pooler.supabase.com:5432/postgres
