      "parameters": {
        "jsCode": "const rows = $input.all();\nconst msgs = rows.map(r => r.json.message).filter(Boolean).reverse();\nconst transcript = msgs.map(m => {\n  const role = (m.type === 'human') ? 'Aluno' : 'Tutor';\n  const content = (m.data && m.data.content) ? m.data.content : '';\n  return role + ': ' + content;\n}).join('\\n');\nconst current = ($('Incrementar Contador').first().json.profile) || {};\nconst userId = $('Normalizar').first().json.userId;\nconst prompt = [\n  'Voce e um analista pedagogico. Atualize o PERFIL de um aluno de ingles com base na transcricao recente.',\n  'Regras: preserve o que ainda for verdade no perfil atual e faca MERGE com o que aprendeu. Nao invente. Seja conciso.',\n  'Responda APENAS com um objeto JSON valido (sem markdown, sem texto extra) com as chaves:',\n  '{\"level\":\"A1|A2|B1|B2|C1\",\"recurring_errors\":[],\"mastered\":[],\"interests\":[],\"notes\":\"\"}',\n  '',\n  'PERFIL ATUAL (JSON):',\n  JSON.stringify(current),\n  '',\n  'TRANSCRICAO RECENTE:',\n  transcript\n].join('\\n');\nreturn { json: { prompt, userId } };"
