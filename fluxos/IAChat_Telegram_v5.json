    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first().json;\nconst raw = (item.output && String(item.output).trim().length) ? String(item.output) : \"Hmm, não entendi direito — pode repetir? 😊\";\nconst LIMIT = 4000;\nfunction split(t, limit) {\n  const chunks = [];\n  let rest = t;\n  while (rest.length > limit) {\n    let cut = rest.lastIndexOf('\\n', limit);\n    if (cut < limit * 0.5) cut = rest.lastIndexOf(' ', limit);\n    if (cut < limit * 0.5) cut = limit;\n    chunks.push(rest.slice(0, cut));\n    rest = rest.slice(cut).replace(/^\\s+/, '');\n  }\n  if (rest.length) chunks.push(rest);\n  return chunks;\n}\nconst parts = split(raw, LIMIT);\nreturn parts.map((p, i) => ({ json: { messageText: p, partIndex: i + 1, partTotal: parts.length } }));"
      },
