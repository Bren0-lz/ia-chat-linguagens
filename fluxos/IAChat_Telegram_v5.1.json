      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const e = $input.item.json;\nlet userId, chatId, type, text = '', callbackData = '', firstName = '', callbackQueryId = null;\nif (e.message) {\n  userId = e.message.from.id;\n  chatId = e.message.chat.id;\n  firstName = e.message.from.first_name || '';\n  if (typeof e.message.text === 'string' && e.message.text.trim().length) {\n    type = 'text';\n    text = e.message.text.trim();\n  } else {\n    type = 'non_text';\n  }\n} else if (e.callback_query) {\n  userId = e.callback_query.from.id;\n  chatId = e.callback_query.message.chat.id;\n  firstName = e.callback_query.from.first_name || '';\n  type = 'callback';\n  callbackData = e.callback_query.data || '';\n  callbackQueryId = e.callback_query.id;\n}\nconst isCommand = type === 'text' && text.startsWith('/');\nconst command = isCommand ? text.split(/\\s+/)[0].toLowerCase() : '';\nreturn { json: { userId, chatId, type, text, callbackData, firstName, isCommand, command, callbackQueryId } };"
      },
