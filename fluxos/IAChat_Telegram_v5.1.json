      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const d = $input.item.json;\n\nfunction sanitizeName(s) {\n  return String(s || '').replace(/[^a-zA-Z\\u00C0-\\u024F\\s'\\-]/g, '').slice(0, 50).trim();\n}\n\nfunction q(v) {\n  return (v === null || v === undefined) ? 'NULL' : \"'\" + String(v).replace(/'/g, \"''\") + \"'\";\n}\n\nlet next, reply, showMenu = false, saveName = null, saveAge = null, menuIntro = null;\n\nif (!d.onboarding || d.onboarding === 'new') {\n  next = 'awaiting_name';\n  reply = \"Oi! Eu sou o IAChat 😊 Qual é o seu nome?\";\n\n} else if (d.onboarding === 'awaiting_name') {\n  saveName = sanitizeName(d.text);\n  if (!saveName) {\n    next = 'awaiting_name';\n    reply = \"Hmm, não entendi o nome 😊 Pode escrever só o seu nome?\";\n  } else {\n    next = 'awaiting_age';\n    reply = \"Prazer, \" + saveName + \"! Quantos anos você tem?\";\n  }\n\n} else if (d.onboarding === 'awaiting_age') {\n  const m = (String(d.text || '').match(/\\d{1,2}/) || [])[0];\n  if (!m) {\n    next = 'awaiting_age';\n    reply = \"Só o número, por favor 😊 Quantos anos você tem?\";\n  } else {\n    saveAge = parseInt(m, 10);\n    next = 'menu';\n    showMenu = true;\n    reply = '';\n    menuIntro = \"Cadastro feito! 🎉 Como você quer começar? 👇\";\n  }\n\n} else {\n  next = 'menu';\n  showMenu = true;\n  reply = '';\n  menuIntro = \"É só tocar em um dos botões abaixo pra começar 👇\";\n}\n\nconst sets = [\"onboarding = \" + q(next), \"updated_at = now()\"];\nif (saveName !== null) sets.push(\"name = \" + q(saveName));\nif (saveAge !== null) sets.push(\"age = \" + parseInt(saveAge, 10));\n\nconst sql = \"UPDATE students SET \" + sets.join(', ') + \" WHERE user_id = \" + parseInt(d.userId, 10) + \";\";\n\nreturn { json: { ...d, next, reply, showMenu, saveName, saveAge, menuIntro, sql } };"
