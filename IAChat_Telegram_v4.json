        "jsCode": "const d = $input.item.json;\nconst mode = d.callbackData === 'mode_teacher' ? 'teacher' : 'chat';\nconst sql = \"UPDATE students SET mode = '\" + mode + \"', onboarding = 'done', updated_at = now() WHERE user_id = \" + parseInt(d.userId, 10) + \";\";\nconst confirm = mode === 'teacher'\n  ? \"📚 Teacher mode! I'll give you exercises and correct them. What do you want to practice?\"\n  : \"💬 Chat mode! Let's just talk 😊 What did you do today?\";\nreturn { json: { ...d, mode, sql, confirm } };"
